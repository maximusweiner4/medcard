<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= patient ? patient.name + "'s Medication List" : "MedCard" %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #f8fafc;
      color: #1e293b;
      padding: 16px;
      max-width: 680px;
      margin: 0 auto;
    }
    .header {
      background: #0f4c81;
      color: #fff;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 16px;
    }
    .header h1 { font-size: 24px; font-weight: 700; margin-bottom: 4px; }
    .header .dob { font-size: 14px; opacity: 0.85; margin-bottom: 12px; }
    .allergy-banner {
      background: #dc2626;
      color: #fff;
      padding: 10px 14px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 15px;
    }
    .allergy-banner.none {
      background: #16a34a;
    }
    .meta {
      font-size: 12px;
      color: #64748b;
      margin-bottom: 16px;
      display: flex;
      justify-content: space-between;
    }
    .section-title {
      font-size: 13px;
      font-weight: 600;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 10px;
    }
    .med-card {
      background: #fff;
      border-radius: 10px;
      border: 1px solid #e2e8f0;
      padding: 16px;
      margin-bottom: 10px;
      display: flex;
      gap: 14px;
      align-items: flex-start;
    }
    .pill-img {
      width: 64px;
      height: 64px;
      object-fit: contain;
      border-radius: 8px;
      background: #f1f5f9;
      flex-shrink: 0;
    }
    .pill-placeholder {
      width: 64px;
      height: 64px;
      border-radius: 8px;
      background: #e2e8f0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      flex-shrink: 0;
    }
    .med-info { flex: 1; }
    .med-name { font-size: 18px; font-weight: 700; color: #0f172a; }
    .med-dose { font-size: 15px; color: #334155; margin-top: 2px; }
    .med-freq {
      display: inline-block;
      background: #dbeafe;
      color: #1e40af;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 500;
      margin-top: 6px;
    }
    .med-instructions { font-size: 13px; color: #64748b; margin-top: 6px; font-style: italic; }
    .med-appearance {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      margin-top: 8px;
    }
    .pill-tag {
      background: #f1f5f9;
      border: 1px solid #e2e8f0;
      padding: 2px 8px;
      border-radius: 6px;
      font-size: 11px;
      color: #475569;
    }
    .footer {
      margin-top: 24px;
      text-align: center;
      font-size: 12px;
      color: #94a3b8;
    }
    .footer strong { color: #0f4c81; }
    .error-box {
      background: #fef2f2;
      border: 1px solid #fca5a5;
      border-radius: 10px;
      padding: 24px;
      text-align: center;
      color: #dc2626;
      font-weight: 500;
    }
    @media print {
      body { background: #fff; }
      .footer { display: none; }
    }
  </style>
</head>
<body>

<% if (error) { %>
  <div class="error-box"><%= error %></div>
<% } else { %>

  <div class="header">
    <h1><%= patient.name %></h1>
    <% if (patient.dateOfBirth) { %>
      <div class="dob">DOB: <%= new Date(patient.dateOfBirth).toLocaleDateString('en-US') %></div>
    <% } %>
    <% if (patient.allergies && patient.allergies.length > 0) { %>
      <div class="allergy-banner">&#9888; ALLERGIES: <%= patient.allergies.join(', ').toUpperCase() %></div>
    <% } else { %>
      <div class="allergy-banner none">&#10003; No Known Drug Allergies</div>
    <% } %>
  </div>

  <div class="meta">
    <span><%= patient.medications.length %> active medication<%= patient.medications.length !== 1 ? 's' : '' %></span>
    <span>Last updated: <%= new Date(lastUpdated).toLocaleDateString('en-US') %></span>
  </div>

  <div class="section-title">Active Medications</div>

  <% if (patient.medications.length === 0) { %>
    <p style="color:#64748b; font-style:italic;">No medications on file.</p>
  <% } else { %>
    <% patient.medications.forEach(function(med) { %>
      <div class="med-card">
        <% if (med.pillImageUrl) { %>
          <img class="pill-img" src="<%= med.pillImageUrl %>" alt="<%= med.drugName %> pill" />
        <% } else { %>
          <div class="pill-placeholder">💊</div>
        <% } %>
        <div class="med-info">
          <div class="med-name"><%= med.drugName %><% if (med.brandName) { %> <span style="font-weight:400;font-size:14px;color:#64748b;">(<%= med.brandName %>)</span><% } %></div>
          <div class="med-dose"><%= [med.dose, med.form, med.route].filter(Boolean).join(' · ') %></div>
          <% if (med.frequency) { %><span class="med-freq"><%= med.frequency %></span><% } %>
          <% if (med.instructions) { %><div class="med-instructions"><%= med.instructions %></div><% } %>
          <% if (med.pillColor || med.pillShape || med.pillImprint) { %>
            <div class="med-appearance">
              <% if (med.pillColor) { %><span class="pill-tag"><%= med.pillColor %></span><% } %>
              <% if (med.pillShape) { %><span class="pill-tag"><%= med.pillShape %></span><% } %>
              <% if (med.pillImprint) { %><span class="pill-tag">Imprint: <%= med.pillImprint %></span><% } %>
            </div>
          <% } %>
        </div>
      </div>
    <% }); %>
  <% } %>

  <div class="footer">
    <p>Generated <%= generatedAt %> via <strong>MedCard</strong></p>
    <p style="margin-top:4px;">This list was prepared by a caregiver and is for reference only.</p>
  </div>

<% } %>
</body>
</html>
